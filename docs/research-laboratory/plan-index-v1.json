  "requirements": [
    {
      "id": "R1",
      "description": "Four separate initial worldview accounts, then attributable collective comparison/revisions with dissent."
    },
    {
      "id": "R2",
      "description": "Two attributed common market feeds with declared rotating per-agent supplements and equal-input comparators."
    },
    {
      "id": "R3",
      "description": "BTC/ETH/SOL initial research; 1m/6h, 5m/2d, 1h/28d, 1d/180d pairs, broader scale retained."
    },
    {
      "id": "R4",
      "description": "Jev after initial accounts freeze, versioned typed judgments with abstention, calibration and preserved dissent."
    },
    {
      "id": "R5",
      "description": "Real Looking Glass/plain inspection parity with claim/evidence identities and replay."
    },
    {
      "id": "R6",
      "description": "Coinbase Prime order placement and lifecycle including cancellation, fills and uncertain submissions."
    },
    {
      "id": "R7",
      "description": "Prime custody and wallet handling with balances, addresses, permissions, signing responsibilities and recovery."
    },
    {
      "id": "R8",
      "description": "Prime funds transfers with network/asset/destination validation, fees and confirmations."
    },
    {
      "id": "R9",
      "description": "Human authorization for initial orders/transfers; account-scoped roles and authority distinct from research access."
    },
    {
      "id": "R10",
      "description": "Exact asset accounting, durable intent identities, external reconciliation and recovery."
    },
    {
      "id": "R11",
      "description": "Preserve historical simulations, units, event lineage and isolation from financial execution."
    },
    {
      "id": "R12",
      "description": "Durable per-agent attempts and explicit cutoff/history/round/horizon timing; roughly ten minutes is unverified."
    },
    {
      "id": "R13",
      "description": "Accessible, plain-state inspection of claims and real action outcomes; no visual implication of consent."
    },
    {
      "id": "R14",
      "description": "Interfractal receives the research/design package now and a planned compatible laboratory integration."
    },
    {
      "id": "R15",
      "description": "Research quality evaluation with equal-information, pooling and single-solver baselines; predictive benefit remains unproven."
    },
    {
      "id": "R16",
      "description": "Operational acceptance, secrets isolation, migrations, recovery/rollback and observability across integrations."
    }
  ],
