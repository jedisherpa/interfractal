  "phaseGuards": {
    "COMPARED": "allfour accepted initial IDs+hashes frozen;pool generated",
    "EXCHANGE_FROZEN": "allfour exchange messages exist with same pre-exchange comparison input;no peer E in input",
    "REVISIONS_FROZEN": "allfour accepted revisions;each correct owninitialparent and allfourE inputmanifest",
    "FINALS_FROZEN": "POOL,UNION,S hashes frozen;S includesallfour revised IDs and no substitution",
    "TRANSFER_RELEASED": "matchingFINALS receipt and allthree artifact hashes;strictinitial modealwaysrejects",
    "SCORED": "three transfer attempts retained;score fixed98denominator evenifinvalid;invalidoutputs remain rejected and stage states clearly marked"
  }
