  "certificateSemantics": {
    "premiseNames": "claim:<claimId>, catalog:<index into catalogRefs>, missing:<index into missingDependencyPaths>, step:<prior stepId>. Only earlier steps allowed.",
    "rules": "Original R01-R10 plus explicit normalization/count/catalog/bundle deductions described in provenance-review; expose each actual rule step. No new truth from score equality.",
    "status": "proved requires a valid finite derivation under delivered complete scope. Exact cited-key-array equality is never the algorithm.",
    "review": "Reviewer IDs correspond to actual engineering review records; scripted demonstration review remains labeled synthetic. No human materials approval generated.",
    "submissionBoundary": "Host expected proofs never supply missing participant premises for credit. Optional versioned proof sidecar binds rawresponse/inputhash;absence doesnotinvalidateoriginalsnapshotshape. Missing essential proof data -> review_required or disproved, no proofpoint. Preserve actual submitted refs separately from host context.",
    "gapMatching": "Typed exact dependency paths or explicit reviewed aliases only; arbitrary free text queues review. No hidden NL inference."
  },
