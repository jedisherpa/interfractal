{
  "schemaVersion": "workspace-supplemental-fixtures/1",
  "origin": "authored_synthetic_acceptance_only",
  "researchOutput": false,
  "mutatesOriginalCorpus": false,
  "commonSemantics": {
    "statusBits": {
      "supported": [
        1,
        0
      ],
      "refuted": [
        0,
        1
      ],
      "conflicted": [
        1,
        1
      ],
      "unknown": [
        0,
        0
      ]
