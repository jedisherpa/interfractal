    "private": "Unauthorized payload omits private body and truth value, but retains an allowed tombstone with availability=private. Redaction applies before both views/exports.",
    "reject": "Invalid actor, scope, version, parent, origin or access leaves semantic state unchanged and appends a rejected attempt.",
    "availability": "separate from four-valued status; never coerce missing/private/not_asked/withdrawn to false or consent"
  },
